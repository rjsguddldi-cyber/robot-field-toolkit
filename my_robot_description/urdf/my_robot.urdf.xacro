<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- ==================== Properties ==================== -->
  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width"  value="0.20"/>
  <xacro:property name="chassis_height" value="0.06"/>
  <xacro:property name="chassis_mass"   value="5.0"/>

  <xacro:property name="wheel_radius"     value="0.05"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_mass"       value="0.5"/>
  <xacro:property name="wheel_separation" value="0.25"/>
  <xacro:property name="wheel_x_offset"   value="0.05"/>  <!-- 전방 오프셋 -->

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_mass"    value="0.1"/>
  
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass"   value="0.2"/>

  <xacro:property name="camera_size"  value="0.04"/>
  <xacro:property name="camera_mass"   value="0.1"/>

  <!-- 2축 팔 (robot_field_toolkit 2층에서 추가). 각도 0 = 팔이 위로 곧게 선 자세 -->
  <xacro:property name="arm_post_x"      value="-0.06"/>  <!-- 차체 뒤쪽: LiDAR(x=0.05)에서 0.15m 안쪽 -->
  <xacro:property name="arm_post_size"   value="0.04"/>
  <xacro:property name="arm_post_height" value="0.06"/>
  <xacro:property name="arm_post_mass"   value="0.2"/>
  <xacro:property name="upper_arm_len"   value="0.15"/>
  <xacro:property name="upper_arm_size"  value="0.03"/>
  <xacro:property name="upper_arm_mass"  value="0.3"/>
  <xacro:property name="forearm_len"     value="0.12"/>
  <xacro:property name="forearm_size"    value="0.025"/>
  <xacro:property name="forearm_mass"    value="0.2"/>
  <xacro:property name="tool_size"       value="0.03"/>
  <xacro:property name="tool_mass"       value="0.05"/>
  <!-- ==================== Inertia Macros ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(y*y+z*z)}" ixy="0.0" ixz="0.0"
               iyy="${m/12*(x*x+z*z)}" iyz="0.0"
               izz="${m/12*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(3*r*r+l*l)}" ixy="0.0" ixz="0.0"
               iyy="${m/12*(3*r*r+l*l)}" iyz="0.0"
               izz="${m/2*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
        <mass value="${m}"/>
        <inertia ixx="${2.0/5.0*m*r*r}" ixy="0.0" ixz="0.0"
                 iyy="${2.0/5.0*m*r*r}" iyz="0.0"
                 izz="${2.0/5.0*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== Wheel Macro ==================== -->
  <xacro:macro name="wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x_offset} ${y_reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
    </gazebo>
  </xacro:macro>

<!-- ==================== Caster Macro ==================== -->
<xacro:macro name="caster" params="prefix x_pos">
  <link name="${prefix}_caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>
  <joint name="${prefix}_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="${prefix}_caster_link"/>
    <origin xyz="${x_pos} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="${prefix}_caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
</xacro:macro>

  <!-- ==================== Links & Joints ==================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       x="${chassis_length}"
                       y="${chassis_width}"
                       z="${chassis_height}"/>
  </link>

  <!-- 좌/우 구동 바퀴 -->
  <xacro:wheel prefix="left"  y_reflect="1"/>
  <xacro:wheel prefix="right" y_reflect="-1"/>

  <!-- 후방 볼캐스터 (전방 바퀴와 균형) -->
  <xacro:caster prefix="rear" x_pos="${-chassis_length/2 + caster_radius}"/>

  <!-- 2D 라이다 -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" l="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${wheel_x_offset} 0 ${chassis_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>
  <!-- 전방 카메라 -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${camera_mass}"
                      x="${camera_size}" y="${camera_size}" z="${camera_size}"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- 카메라 광학 프레임 (ROS 카메라 좌표계) -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <!-- IMU (PHM 1단계에서 추가): 차체 중심. 링크만 두고 센서는 아래 gazebo 블록 -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- IMU 센서 → /imu 토픽 (월드의 gz-sim-imu-system이 계산). 잡음은 저가형 MEMS IMU 수준 초안 -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- 2D 라이다 센서 → /scan 토픽 -->
<gazebo reference="lidar_link">
  <sensor name="lidar" type="gpu_lidar">
    <always_on>true</always_on>
    <visualize>false</visualize>
    <update_rate>10</update_rate>
    <topic>scan</topic>
    <gz_frame_id>lidar_link</gz_frame_id>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-${pi}</min_angle>
          <max_angle>${pi}</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.15</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
  </sensor>
</gazebo>

<!-- 전방 카메라 센서 → /camera/image, /camera/camera_info -->
<gazebo reference="camera_link">
  <sensor name="camera" type="camera">
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <topic>camera/image</topic>
    <gz_frame_id>camera_optical_link</gz_frame_id>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
    </camera>
  </sensor>
</gazebo>



  <!-- ==================== 2축 팔 ==================== -->
  <!-- 팔 받침(post): 차체 위 뒤쪽 -->
  <link name="arm_base_link">
    <visual>
      <geometry><box size="${arm_post_size} ${arm_post_size} ${arm_post_height}"/></geometry>
      <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${arm_post_size} ${arm_post_size} ${arm_post_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${arm_post_mass}" x="${arm_post_size}" y="${arm_post_size}" z="${arm_post_height}"/>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="${arm_post_x} 0 ${chassis_height/2 + arm_post_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- 위팔: 어깨(pitch) 관절. +각도 = 앞으로 숙임 -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 ${upper_arm_len/2}" rpy="0 0 0"/>
      <geometry><box size="${upper_arm_size} ${upper_arm_size} ${upper_arm_len}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_arm_len/2}" rpy="0 0 0"/>
      <geometry><box size="${upper_arm_size} ${upper_arm_size} ${upper_arm_len}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${upper_arm_len/2}" rpy="0 0 0"/>
      <mass value="${upper_arm_mass}"/>
      <inertia ixx="${upper_arm_mass/12*(upper_arm_size**2+upper_arm_len**2)}" ixy="0" ixz="0"
               iyy="${upper_arm_mass/12*(upper_arm_size**2+upper_arm_len**2)}" iyz="0"
               izz="${upper_arm_mass/6*upper_arm_size**2}"/>
    </inertial>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 ${arm_post_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.57" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <!-- 아래팔: 팔꿈치(pitch) 관절 -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 ${forearm_len/2}" rpy="0 0 0"/>
      <geometry><box size="${forearm_size} ${forearm_size} ${forearm_len}"/></geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${forearm_len/2}" rpy="0 0 0"/>
      <geometry><box size="${forearm_size} ${forearm_size} ${forearm_len}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${forearm_len/2}" rpy="0 0 0"/>
      <mass value="${forearm_mass}"/>
      <inertia ixx="${forearm_mass/12*(forearm_size**2+forearm_len**2)}" ixy="0" ixz="0"
               iyy="${forearm_mass/12*(forearm_size**2+forearm_len**2)}" iyz="0"
               izz="${forearm_mass/6*forearm_size**2}"/>
    </inertial>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 ${upper_arm_len}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="2.7" effort="3.0" velocity="1.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- 툴(그리퍼 자리 표시용, 파지는 구현하지 않음) -->
  <link name="tool_link">
    <visual>
      <geometry><box size="${tool_size} ${tool_size} ${tool_size}"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><box size="${tool_size} ${tool_size} ${tool_size}"/></geometry>
    </collision>
    <xacro:box_inertia m="${tool_mass}" x="${tool_size}" y="${tool_size}" z="${tool_size}"/>
  </link>
  <joint name="tool_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 ${forearm_len + tool_size/2}" rpy="0 0 0"/>
  </joint>

  <!-- 관절 위치 제어 (gz 토픽 arm/shoulder_cmd, arm/elbow_cmd, gz.msgs.Double [rad]) -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_joint</joint_name>
      <topic>arm/shoulder_cmd</topic>
      <!-- P를 키워 중력 처짐을 줄이고(약 0.7Nm/30 = 0.02rad), 적분 한계를 낮춰 한계에서 버틸 때 적분 누적을 줄임 -->
      <p_gain>30.0</p_gain>
      <i_gain>2.0</i_gain>
      <d_gain>1.0</d_gain>
      <i_max>0.5</i_max>
      <i_min>-0.5</i_min>
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_joint</joint_name>
      <topic>arm/elbow_cmd</topic>
      <p_gain>15.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.3</d_gain>
      <i_max>0.3</i_max>
      <i_min>-0.3</i_min>
      <cmd_max>3.0</cmd_max>
      <cmd_min>-3.0</cmd_min>
      <initial_position>2.6</initial_position>
    </plugin>
  </gazebo>

<!-- ==================== Gazebo Plugins ==================== -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
          name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

<!-- 바퀴·팔 조인트 상태 발행 → /joint_states → robot_state_publisher TF (같은 플러그인에 팔 관절 추가) -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>shoulder_joint</joint_name>
      <joint_name>elbow_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
